# Unit de template: o nome após o @ é o usuário dono do clone em /home/<usuário>/Solar-hub
#   sudo systemctl enable --now solar-inverters@<usuário>.service
[Unit]
Description=Solar Hub - Coletor de Telemetria Solar (24/7)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/home/%i/Solar-hub/collector
ExecStart=/home/%i/Solar-hub/collector/.venv/bin/python /home/%i/Solar-hub/collector/inverters.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardening de segurança
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/home/%i/Solar-hub/collector

[Install]
WantedBy=multi-user.target
