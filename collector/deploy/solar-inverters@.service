# Template unit: the name after @ is the user owning the clone in /home/<user>/Solar-hub
#   sudo systemctl enable --now solar-inverters@<user>.service
[Unit]
Description=Solar Hub - Solar Inverter Telemetry Edge Collector (24/7)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/home/%i/Solar-hub/collector
ExecStart=/home/%i/Solar-hub/collector/.venv/bin/python /home/%i/Solar-hub/collector/inverters.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/home/%i/Solar-hub/collector

[Install]
WantedBy=multi-user.target
