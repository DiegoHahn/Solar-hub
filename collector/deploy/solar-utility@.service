# Utility synchronization service, triggered by solar-utility@.timer
[Unit]
Description=Solar Hub - Utility Synchronization (Cooperaliança)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=%i
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/home/%i/Solar-hub/collector
ExecStart=/home/%i/Solar-hub/collector/.venv/bin/python /home/%i/Solar-hub/collector/utility.py --pdf
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/home/%i/Solar-hub/collector
