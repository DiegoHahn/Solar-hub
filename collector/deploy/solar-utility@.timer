# Runs utility synchronization at 07:00, 13:00, and 19:00 (utility portal can be unstable overnight)
#   sudo systemctl enable --now solar-utility@<user>.timer
[Unit]
Description=Solar Hub - Utility Sync Timer (Cooperaliança)

[Timer]
OnCalendar=*-*-* 07,13,19:00:00
Persistent=true

[Install]
WantedBy=timers.target
