# Supabase: a service_role key ignora RLS e é usada apenas pelos coletores (nunca no front)
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role

# Portal da concessionária (Cooperaliança / Useall)
COOPERALIANCA_CPF="00000000000"
COOPERALIANCA_SENHA="sua_senha"
COOPERALIANCA_TOKEN_EXTERNO="token_externo_da_useall"
# Unidades consumidoras do titular, separadas por vírgula (a primeira é a UC geradora)
COOPERALIANCA_UCS="0000000000,0000000001"

# Nível de log dos coletores: DEBUG, INFO (padrão), WARNING ou ERROR.
# Também pode vir do ambiente do processo (ex.: Environment=LOG_LEVEL=DEBUG no systemd), que tem prioridade.
# LOG_LEVEL=INFO
