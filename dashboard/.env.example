NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua_chave_anon_ou_publishable

# E-mails autorizados a entrar via Google, separados por vírgula (vazio = qualquer conta)
ALLOWED_EMAILS=voce@exemplo.com

# Coordenadas geográficas e orientação da Usina (Open-Meteo)
NEXT_PUBLIC_SOLAR_LATITUDE=-28.7139
NEXT_PUBLIC_SOLAR_LONGITUDE=-49.3003
NEXT_PUBLIC_SOLAR_AZIMUTH=155
NEXT_PUBLIC_SOLAR_TILT=15
# DC capacity of the PV modules (kWp), used for performance ratio and estimates
NEXT_PUBLIC_PLANT_DC_KWP=19.36

# Google AI Studio (Gemini API)
# Configure o modelo primário e a lista de fallbacks (em ordem de prioridade, separados por vírgula).
# Toda a seleção de modelos e fallbacks é controlada aqui sem nenhuma dependência fixa no código.
GEMINI_API_KEY=sua_chave_do_google_ai_studio
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_FALLBACKS=gemini-3.7-flash,gemini-3.6-flash
GEMINI_PRIMARY_MAX_QUOTA=4
