[Unit]
Description=Solar Hub - Coletor de Telemetria Solar (24/7)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Ajuste para o seu usuário no Ubuntu se for diferente (ex: orangepi ou ubuntu)
User=%I
WorkingDirectory=/home/%I/Solar-hub
ExecStart=/home/%I/Solar-hub/.venv/bin/python /home/%I/Solar-hub/collector_inverters.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
