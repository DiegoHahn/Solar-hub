{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "package-name": "solar-hub",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "dashboard/package.json",
          "jsonpath": "$.version"
        }
      ]
    }
  },
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Funcionalidades"
    },
    {
      "type": "fix",
      "section": "Correções"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "refactor",
      "section": "Refatoração"
    },
    {
      "type": "test",
      "section": "Testes"
    },
    {
      "type": "docs",
      "section": "Documentação"
    },
    {
      "type": "ci",
      "section": "CI",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Manutenção",
      "hidden": true
    },
    {
      "type": "style",
      "section": "Estilo",
      "hidden": true
    }
  ]
}
